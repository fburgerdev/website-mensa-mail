{
  // Cloudflare: liefert die Seite aus public/ aus, counter/worker.js zählt die Mails pro Woche.
  "name": "website-mensa-mail",
  "main": "counter/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "COUNTS", "id": "455144e40787434ca3309277ffd28452" }
  ]
}
